# TransforMind AI Environment Configuration
ENV=development
DATABASE_URL=sqlite+aiosqlite:///./transformind.db

# Optional LLM API Keys (OpenRouter / DeepSeek)
OPENROUTER_API_KEY=
DEEPSEEK_MODEL=deepseek/deepseek-chat

# External Telemetry Connectors (Optional - Built-in verified offline telemetry presets are used when omitted)
NEWS_API_KEY=
ALPHA_VANTAGE_API_KEY=
GITHUB_API_TOKEN=

# Vector Database (In-Memory default or Qdrant Server)
QDRANT_HOST=:memory:
QDRANT_PORT=6333
