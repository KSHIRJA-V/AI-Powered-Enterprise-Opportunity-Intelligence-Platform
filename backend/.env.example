# Enterprise Opportunity Intelligence & Strategic Decision Support Platform
# Environment Configuration

ENV=development
PROJECT_NAME="Enterprise Opportunity Intelligence Platform"
API_PREFIX=/api
DATABASE_URL=sqlite+aiosqlite:///./opportunity_intel.db

# LLM & OpenRouter API Keys (Optional)
OPENROUTER_API_KEY=
DEEPSEEK_MODEL=deepseek/deepseek-chat

# External Data Feeds (Optional)
NEWS_API_KEY=
ALPHA_VANTAGE_API_KEY=
GITHUB_API_TOKEN=

# Qdrant Vector DB
QDRANT_HOST=:memory:
QDRANT_PORT=6333
QDRANT_COLLECTION=enterprise_evidence

# SMTP & Live Email Delivery Settings (Gmail SMTP)
# To send real emails:
# 1. Enable 2-Step Verification in Google Account (https://myaccount.google.com/security)
# 2. Generate a 16-character App Password at https://myaccount.google.com/apppasswords
# 3. Enter your Gmail address and 16-character App Password below (or inside the UI Modal)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=
